projection;
strict ( 2 );
use draft;

define behavior for ZC_CMP_HDR alias Complaint
{
  use create;
  use update;

  use action CloseComplaint;
  use action CancelComplaint;
  use action ResolveComplaint;
  use action AssignAgent;
  use action StartProcessing;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Comments { create; with draft; }
}

define behavior for ZC_CMP_COMMENT alias Comment
{
  use association _Complaint { with draft; }
}